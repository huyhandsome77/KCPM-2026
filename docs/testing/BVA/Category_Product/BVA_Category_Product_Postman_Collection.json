{
	"info": {
		"_postman_id": "bva-category-product-suite-2026",
		"name": "FutureSushi - BVA Category & Product API Test Suite",
		"description": "Bộ kiểm thử tự động phân tích giá trị biên (Boundary Value Analysis - BVA) cho các input của Category và Product API theo đúng chuẩn backend FutureSushi.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Khởi tạo các chuỗi độ dài biên tự động",
					"pm.collectionVariables.set('cat_name_99', 'A'.repeat(99));",
					"pm.collectionVariables.set('cat_name_100', 'A'.repeat(100));",
					"pm.collectionVariables.set('cat_name_101', 'A'.repeat(101));",
					"",
					"pm.collectionVariables.set('prd_name_149', 'P'.repeat(149));",
					"pm.collectionVariables.set('prd_name_150', 'P'.repeat(150));",
					"pm.collectionVariables.set('prd_name_151', 'P'.repeat(151));",
					"",
					"if (!pm.collectionVariables.get('temp_cat_id')) {",
					"    pm.collectionVariables.set('temp_cat_id', '1');",
					"}",
					"if (!pm.collectionVariables.get('temp_prd_id')) {",
					"    pm.collectionVariables.set('temp_prd_id', '1');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Kiểm tra thời gian phản hồi API (< 1000ms)",
					"pm.test('[Non-Functional] Response time is acceptable (< 1000ms)', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(1000);",
					"});",
					"",
					"// Kiểm tra Content-Type JSON",
					"pm.test('[Header] Content-Type is application/json (if response has body)', function () {",
					"    if (pm.response.code !== 204 && pm.response.text()) {",
					"        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
					"    }",
					"});"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "temp_cat_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "temp_prd_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Authentication (Lấy Token Admin)",
			"item": [
				{
					"name": "AUTH - Đăng nhập lấy Token Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const json = pm.response.json();",
									"pm.test('Login returns valid token & admin role', function () {",
									"    pm.expect(json).to.have.property('token');",
									"    pm.expect(json.token).to.be.a('string').and.not.empty;",
									"    pm.expect(json.user.role).to.eql('ADMIN');",
									"});",
									"if (json.token) {",
									"    pm.collectionVariables.set('admin_token', json.token);",
									"    pm.environment.set('admin_token', json.token);",
									"    console.log('Saved admin_token successfully:', json.token.substring(0, 15) + '...');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"account\": \"admin\",\n    \"password\": \"123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				}
			]
		},
