    {
      "name": "BVA-RES-01",
      "item": [
        {
          "name": "BVA-RES-01 - Create Reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guestName\": \"{{guestName}}\",\n  \"guestPhone\": \"{{guestPhone}}\",\n  \"reservationTime\": \"{{reservationTime}}\",\n  \"numberOfGuests\": 2,\n  \"note\": \"BVA BVA-RES-01\",\n  \"user_id\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const offsetMinutes = -30;",
                  "const t = new Date(Date.now() + offsetMinutes * 60 * 1000);",
                  "pm.environment.set(\"reservationTime\", t.toISOString());",
                  "pm.environment.set(\"guestName\", \"BVA Reservation BVA-RES-01\");",
                  "pm.environment.set(\"guestPhone\", \"09\" + Date.now().toString().slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 201\", function () {",
                  "pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "const json = pm.response.json();",
                  "pm.test(\"Reservation created\", function () {",
                  "pm.expect(json).to.have.property(\"data\");",
                  "});",
                  "if (json.data && json.data.id) {",
                  "pm.environment.set(\"reservationId\", json.data.id);",
                  "}",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "BVA-RES-01 - Check-in",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{reservationId}}/check-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations",
                "{{reservationId}}",
                "check-in"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () {",
                  "pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Check-in success message exists\", function () {",
                  "const json = pm.response.json();",
                  "pm.expect(json.message).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
