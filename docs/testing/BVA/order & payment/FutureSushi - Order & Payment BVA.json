  "item": [
    {
      "name": "0. Authentication & Pre-condition Setup",
      "item": [
        {
          "name": "TC_AUTH_001 - Đăng nhập tài khoản Admin lấy Token JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[TC_AUTH_001] Status 200 OK & Lấy token JWT\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res).to.have.property('token');",
                  "    pm.collectionVariables.set('admin_token', res.token);",
                  "    if (res.user && res.user.id) {",
                  "        pm.collectionVariables.set('admin_id', res.user.id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"admin\",\n  \"password\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "TC_SETUP_002 - Cấp điểm tích lũy tối đa theo SRS (10.000.000 điểm)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[TC_SETUP_002] Cấp điểm tích lũy theo SRS thành công\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"points\": 10000000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{admin_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{admin_id}}"]
            }
          }
        },
        {
          "name": "TC_SETUP_003 - Khởi tạo tồn kho và giá mặc định cho Product 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[TC_SETUP_003] Reset Product 1 thành công\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 150000,\n  \"stock\": 100000,\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            }
          }
        }
      ]
