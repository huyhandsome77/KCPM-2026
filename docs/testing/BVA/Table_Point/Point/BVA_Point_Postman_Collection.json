{
  "info": {
    "_postman_id": "future-sushi-bva-point-2026",
    "name": "FutureSushi - BVA Point API Test Suite",
    "description": "Boundary Value Analysis (BVA) test suite for Point API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "AUTH - Đăng nhập Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"admin\",\n  \"password\": \"123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "var res = pm.response.json();",
                  "if (res.token) { pm.collectionVariables.set('admin_token', res.token); pm.environment.set('admin_token', res.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
