        {
          "name": "BVA-TB-001 - Baseline / Nominal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": 600,\n  \"capacity\": 4,\n  \"qrCode\": \"BVA-BASE-600\",\n  \"status\": \"AVAILABLE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tables"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('bvaBody', \"{\\n  \\\"tableNumber\\\": 600,\\n  \\\"capacity\\\": 4,\\n  \\\"qrCode\\\": \\\"BVA-BASE-600\\\",\\n  \\\"status\\\": \\\"AVAILABLE\\\"\\n}\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201',()=>pm.response.to.have.status(201));",
                  "pm.test('Response is JSON',()=>pm.response.to.be.json);",
                  "pm.test('Response time < 1000ms',()=>pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const d=pm.response.json(); const e=JSON.parse(pm.variables.get('bvaBody'));",
                  "pm.test('Payload has message',()=>pm.expect(d).to.have.property('message'));",
                  "pm.test('Payload has table object',()=>pm.expect(d.table).to.be.an('object'));",
                  "pm.test('tableNumber matches input',()=>pm.expect(Number(d.table.tableNumber)).to.eql(Number(e.tableNumber)));",
                  "pm.test('capacity matches input',()=>pm.expect(Number(d.table.capacity)).to.eql(Number(e.capacity)));",
                  "pm.test('qrCode matches input',()=>pm.expect(String(d.table.qrCode)).to.eql(String(e.qrCode)));",
                  "pm.test('status matches input',()=>pm.expect(String(d.table.status)).to.eql(String(e.status)));",
                  "if(d.table && d.table.id){pm.sendRequest({url:pm.environment.get('baseUrl')+'/api/tables/'+d.table.id,method:'DELETE'},()=>{});}"
                ]
              }
            }
          ]
        },
