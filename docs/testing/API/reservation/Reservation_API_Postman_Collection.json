          "name": "Auth - Login as Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer login success', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.token).to.be.a('string');",
                  "    pm.collectionVariables.set('customer_token', res.token);",
                  "    pm.environment.set('customer_token', res.token);",
                  "    pm.globals.set('customer_token', res.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"account\":\"customer\",\"password\":\"123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
