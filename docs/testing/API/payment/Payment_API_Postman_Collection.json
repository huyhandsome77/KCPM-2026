{
  "info": {
    "_postman_id": "api-payment-collection-2026",
    "name": "Payment API Test Suite",
    "description": "Bộ kiểm thử tự động cho Module Payment & PayOS Integration API (/api/payments, /api/payos).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00. Auth Setup",
      "item": [
        {
          "name": "Auth - Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login admin success', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.collectionVariables.set('admin_token', res.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"account\":\"admin\",\"password\":\"123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01. Payment Operations",
      "item": [
        {
          "name": "TC_API_PAY_001 - Lấy danh sách giao dịch thanh toán",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments"
              ]
            }
          }
        },
        {
          "name": "TC_API_PAY_002 - Tạo link thanh toán PayOS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK or 400 Handled', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"orderId\":1,\"amount\":50000,\"description\":\"Thanh toan don hang test\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payos/create-payment-link",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payos",
                "create-payment-link"
              ]
            }
          }
        },
        {
          "name": "TC_API_PAY_003 - Kiểm tra trạng thái đơn hàng PayOS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 400/404 Handled', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payos/order-status/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payos",
                "order-status",
                "1"
              ]
            }
          }
        },
        {
          "name": "TC_API_PAY_004 - Xác nhận Webhook từ PayOS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"code\":\"00\",\"desc\":\"success\",\"data\":{\"orderCode\":123456,\"amount\":50000,\"description\":\"Thanh toan test\",\"accountNumber\":\"123456789\",\"reference\":\"FT12345\",\"transactionDateTime\":\"2026-09-03T04:19:52.096Z\",\"currency\":\"VND\",\"paymentLinkId\":\"test_link_id\",\"code\":\"00\",\"desc\":\"success\"},\"signature\":\"test_signature\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payos/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payos",
                "webhook"
              ]
            }
          }
        }
      ]
    }
  ]
}