              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var list = pm.response.json();",
                  "    pm.expect(list).to.be.an('array');",
                  "    if (list.length > 0) {",
