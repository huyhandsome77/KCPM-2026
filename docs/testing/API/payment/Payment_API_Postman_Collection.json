{
  "info": {
    "_postman_id": "api-payment-collection-2026",
    "name": "Payment API Test Suite",
    "description": "Bộ kiểm thử tự động toàn diện cho Module Payment & Cổng thanh toán chuyển khoản PayOS (/api/payments, /api/payos). Bao gồm quản lý lịch sử thanh toán tiền mặt/chuyển khoản, tìm kiếm, lọc, tạo link PayOS, Webhook IPN và Return URLs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "testPaymentId",
      "value": "1",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-Auth Script: Tự động lấy token Admin nếu chưa có",
          "const baseUrl = pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl') || 'http://localhost:3000';",
          "const reqName = pm.info.requestName || '';",
          "",
          "if (!reqName.includes('Login')) {",
          "    const adminToken = pm.collectionVariables.get('admin_token') || pm.environment.get('admin_token') || pm.globals.get('admin_token');",
          "    if (!adminToken) {",
          "        pm.sendRequest({",
          "            url: baseUrl + '/api/auth/login',",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/json' },",
          "            body: { mode: 'raw', raw: JSON.stringify({ account: 'admin', password: '123' }) }",
          "        }, function (err, res) {",
          "            if (!err && res.code === 200) {",
          "                const data = res.json();",
          "                if (data.token) {",
          "                    pm.collectionVariables.set('admin_token', data.token);",
          "                    pm.environment.set('admin_token', data.token);",
          "                    pm.globals.set('admin_token', data.token);",
          "                }",
          "            }",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00. Auth Setup",
      "item": [
        {
          "name": "Auth - Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login success', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.token).to.be.a('string');",
                  "    pm.collectionVariables.set('admin_token', res.token);",
                  "    pm.environment.set('admin_token', res.token);",
                  "    pm.globals.set('admin_token', res.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"account\":\"admin\",\"password\":\"123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01. Payment Transactions Management (/api/payments)",
