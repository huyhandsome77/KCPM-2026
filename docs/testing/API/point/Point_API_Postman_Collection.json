{
  "info": {
    "_postman_id": "api-point-collection-2026",
    "name": "Point API Test Suite",
    "description": "Bộ kiểm thử tự động cho Module Tích điểm Khách hàng (/api/points).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00. Auth Setup",
      "item": [
        {
          "name": "Auth - Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login success', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.collectionVariables.set('admin_token', res.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"account\":\"admin\",\"password\":\"123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01. Point Operations",
      "item": [
        {
          "name": "TC_API_PNT_001 - Tích điểm thành công cho khách hàng qua số điện thoại",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK or 400 Handled', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\":\"0900000002\",\"orderId\":1}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/points/add-points",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "points",
                "add-points"
              ]
            }
          }
        },
        {
          "name": "TC_API_PNT_002 - Tích điểm thất bại khi thiếu trường phone",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"orderId\":1}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/points/add-points",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "points",
                "add-points"
              ]
            }
          }
        },
        {
          "name": "TC_API_PNT_003 - Tích điểm thất bại khi thiếu trường orderId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\":\"0900000002\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/points/add-points",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "points",
                "add-points"
              ]
            }
          }
        },
        {
          "name": "TC_API_PNT_004 - Tích điểm thất bại khi số điện thoại không tồn tại",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 or 400', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\":\"0999999999\",\"orderId\":1}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/points/add-points",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "points",
                "add-points"
              ]
            }
          }
        }
      ]
    }
  ]
}