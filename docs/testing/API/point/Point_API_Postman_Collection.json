  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-Auth Script: Tự động lấy token Admin, Staff, Customer nếu chưa có",
          "const baseUrl = pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl') || 'http://localhost:3000';",
          "const reqName = pm.info.requestName || '';",
          "",
          "if (!reqName.includes('Login') && !reqName.includes('401')) {",
          "    const staffToken = pm.collectionVariables.get('staff_token') || pm.environment.get('staff_token') || pm.globals.get('staff_token');",
          "    const customerToken = pm.collectionVariables.get('customer_token') || pm.environment.get('customer_token') || pm.globals.get('customer_token');",
          "    const adminToken = pm.collectionVariables.get('admin_token') || pm.environment.get('admin_token') || pm.globals.get('admin_token');",
          "",
          "    if (!staffToken) {",
          "        pm.sendRequest({",
          "            url: baseUrl + '/api/auth/login',",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/json' },",
          "            body: { mode: 'raw', raw: JSON.stringify({ account: 'staff', password: '123' }) }",
          "        }, function (err, res) {",
          "            if (!err && res.code === 200) {",
          "                const data = res.json();",
          "                if (data.token) {",
          "                    pm.collectionVariables.set('staff_token', data.token);",
          "                    pm.environment.set('staff_token', data.token);",
          "                    pm.globals.set('staff_token', data.token);",
          "                }",
          "            }",
          "        });",
          "    }",
          "",
          "    if (!customerToken) {",
          "        pm.sendRequest({",
          "            url: baseUrl + '/api/auth/login',",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/json' },",
          "            body: { mode: 'raw', raw: JSON.stringify({ account: 'customer', password: '123' }) }",
          "        }, function (err, res) {",
          "            if (!err && res.code === 200) {",
          "                const data = res.json();",
          "                if (data.token) {",
          "                    pm.collectionVariables.set('customer_token', data.token);",
          "                    pm.environment.set('customer_token', data.token);",
          "                    pm.globals.set('customer_token', data.token);",
          "                }",
          "            }",
          "        });",
          "    }",
          "",
          "    if (!adminToken) {",
          "        pm.sendRequest({",
          "            url: baseUrl + '/api/auth/login',",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/json' },",
          "            body: { mode: 'raw', raw: JSON.stringify({ account: 'admin', password: '123' }) }",
          "        }, function (err, res) {",
          "            if (!err && res.code === 200) {",
          "                const data = res.json();",
          "                if (data.token) {",
          "                    pm.collectionVariables.set('admin_token', data.token);",
          "                    pm.environment.set('admin_token', data.token);",
          "                    pm.globals.set('admin_token', data.token);",
          "                }",
          "            }",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00. Auth Setup",
      "item": [
        {
          "name": "Auth - Login as Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer login success', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.token).to.be.a('string');",
                  "    pm.collectionVariables.set('customer_token', res.token);",
                  "    if (res.user && res.user.phone) {",
                  "        pm.collectionVariables.set('customer_phone', res.user.phone);",
                  "        pm.variables.set('customer_phone', res.user.phone);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"account\":\"customer\",\"password\":\"123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Auth - Login as Staff",
          "event": [
            {
