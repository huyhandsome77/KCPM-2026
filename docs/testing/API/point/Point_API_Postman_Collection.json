    {
      "name": "03. Business Logic & Point Calculation Flow",
      "item": [
        {
          "name": "TC_API_PNT_009 - Setup tạo đơn hàng mới cho khách để chuẩn bị tích điểm",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const baseUrl = pm.collectionVariables.get('baseUrl') || 'http://localhost:3000';",
                  "pm.sendRequest(baseUrl + '/api/products', function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        const products = res.json();",
                  "        const avail = Array.isArray(products) ? products.find(p => p.isAvailable && p.stock > 0) : null;",
                  "        if (avail) {",
                  "            pm.collectionVariables.set('testPointProductId', String(avail.id));",
                  "            pm.variables.set('testPointProductId', String(avail.id));",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var res = pm.response.json();",
                  "    var order = res.data || res.order || res;",
                  "    pm.collectionVariables.set('testPointOrderId', String(order.id));",
                  "    pm.variables.set('testPointOrderId', String(order.id));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"table_id\": 2,\n  \"items\": [\n    {\n      \"product_id\": {{testPointProductId}},\n      \"quantity\": 1\n    }\n  ],\n  \"note\": \"Đơn hàng test tích điểm 5%\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        },
