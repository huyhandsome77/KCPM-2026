          }
        },
        {
          "name": "TC_API_PNT_013 - Nhân viên tích điểm thành công cho khách hàng & kiểm tra công thức 5%",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Verify earnedPoints calculation (5% of order final price)', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res).to.have.property('earnedPoints');",
                  "    pm.expect(res.earnedPoints).to.be.greaterThan(0);",
                  "    pm.expect(res).to.have.property('totalPoints');",
                  "    pm.expect(res.message).to.include('Tích điểm thành công');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
