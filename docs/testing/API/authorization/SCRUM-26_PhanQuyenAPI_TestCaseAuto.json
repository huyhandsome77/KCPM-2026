      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const ts = Date.now();",
              "pm.collectionVariables.set('staffUsername', 'staff' + ts);",
              "pm.collectionVariables.set('staffEmail', 'staff' + ts + '@example.com');",
              "pm.collectionVariables.set('staffPhone', '090' + String(ts).slice(-8));",
              ""
