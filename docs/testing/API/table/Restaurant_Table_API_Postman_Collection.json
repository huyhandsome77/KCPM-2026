            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": {{dynamicTableNumber}},\n  \"capacity\": 4,\n  \"qrCode\": \"{{dynamicQrCode}}\",\n  \"status\": \"AVAILABLE\"\n}"
