{
  "info": {
    "_postman_id": "api-table-collection-2026",
    "name": "Restaurant Table API Test Suite",
    "description": "Bộ kiểm thử tự động toàn diện cho Module Restaurant Table API (/api/tables). Kiểm thử CRUD bàn ăn, quét QR Code đa định dạng, các trường tính toán trạng thái động theo thời gian thực (Live Table Status), bulk create và các quy tắc nghiệp vụ an toàn.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdTableId",
      "value": "",
      "type": "string"
    },
    {
      "key": "dynamicTableNumber",
      "value": "150",
      "type": "string"
    },
    {
      "key": "dynamicQrCode",
      "value": "QR_TBL_150",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Sinh số bàn động để không bị trùng lặp khi chạy lại nhiều lần",
          "const randomNum = Math.floor(Math.random() * 800) + 100;",
          "pm.collectionVariables.set('dynamicTableNumber', String(randomNum));",
          "pm.collectionVariables.set('dynamicQrCode', 'QR_TBL_' + randomNum);",
          "",
          "// Auto-Auth Script",
          "const baseUrl = pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl') || 'http://localhost:3000';",
          "const reqName = pm.info.requestName || '';",
          "",
          "if (!reqName.includes('Login')) {",
          "    const adminToken = pm.collectionVariables.get('admin_token') || pm.environment.get('admin_token') || pm.globals.get('admin_token');",
          "    if (!adminToken) {",
          "        pm.sendRequest({",
          "            url: baseUrl + '/api/auth/login',",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/json' },",
          "            body: { mode: 'raw', raw: JSON.stringify({ account: 'admin', password: '123' }) }",
          "        }, function (err, res) {",
          "            if (!err && res.code === 200) {",
          "                const data = res.json();",
          "                if (data.token) {",
          "                    pm.collectionVariables.set('admin_token', data.token);",
          "                    pm.environment.set('admin_token', data.token);",
          "                    pm.globals.set('admin_token', data.token);",
          "                }",
          "            }",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00. Auth Setup",
      "item": [
        {
          "name": "Auth - Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login success', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.token).to.be.a('string');",
                  "    pm.collectionVariables.set('admin_token', res.token);",
                  "    pm.environment.set('admin_token', res.token);",
                  "    pm.globals.set('admin_token', res.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"account\":\"admin\",\"password\":\"123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01. Table CRUD & Status Management",
      "item": [
        {
          "name": "TC_API_TBL_001 - Lấy danh sách tất cả các bàn & Kiểm tra các trường tính toán thời gian thực",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var tables = pm.response.json();",
                  "    pm.expect(tables).to.be.an('array');",
                  "    if (tables.length > 0) {",
                  "        var first = tables[0];",
                  "        pm.expect(first).to.have.property('tableNumber');",
                  "        pm.expect(first).to.have.property('capacity');",
                  "        pm.expect(first).to.have.property('calculatedStatus');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tables",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tables"
              ]
            }
          }
        },
        {
          "name": "TC_API_TBL_002 - Tạo bàn mới thành công",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created or 200 OK', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    var res = pm.response.json();",
                  "    var table = res.table || res.data || res;",
                  "    pm.expect(table).to.have.property('id');",
                  "    pm.collectionVariables.set('createdTableId', String(table.id));",
                  "    pm.environment.set('createdTableId', String(table.id));",
                  "    pm.globals.set('createdTableId', String(table.id));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
