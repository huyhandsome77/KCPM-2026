  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-Auth Script: Tự động đăng nhập lấy token nếu chưa có",
          "const baseUrl = pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl') || 'http://localhost:3000';",
          "const reqName = pm.info.requestName || '';",
          "",
          "if (!reqName.includes('Login')) {",
          "    const adminToken = pm.collectionVariables.get('admin_token') || pm.environment.get('admin_token') || pm.globals.get('admin_token');",
          "    const customerToken = pm.collectionVariables.get('customer_token') || pm.environment.get('customer_token') || pm.globals.get('customer_token');",
          "    const staffToken = pm.collectionVariables.get('staff_token') || pm.environment.get('staff_token') || pm.globals.get('staff_token');",
          "",
          "    if (!adminToken) {",
          "        pm.sendRequest({",
          "            url: baseUrl + '/api/auth/login',",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/json' },",
          "            body: { mode: 'raw', raw: JSON.stringify({ account: 'admin', password: '123' }) }",
          "        }, function (err, res) {",
          "            if (!err && res.code === 200) {",
          "                const data = res.json();",
          "                if (data.token) {",
          "                    pm.collectionVariables.set('admin_token', data.token);",
          "                    pm.environment.set('admin_token', data.token);",
          "                    pm.globals.set('admin_token', data.token);",
          "                }",
          "            }",
          "        });",
          "    }",
          "",
          "    if (!customerToken) {",
          "        pm.sendRequest({",
          "            url: baseUrl + '/api/auth/login',",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/json' },",
          "            body: { mode: 'raw', raw: JSON.stringify({ account: 'customer', password: '123' }) }",
          "        }, function (err, res) {",
          "            if (!err && res.code === 200) {",
          "                const data = res.json();",
          "                if (data.token) {",
          "                    pm.collectionVariables.set('customer_token', data.token);",
          "                    pm.environment.set('customer_token', data.token);",
          "                    pm.globals.set('customer_token', data.token);",
          "                }",
          "            }",
          "        });",
          "    }",
          "",
          "    if (!staffToken) {",
          "        pm.sendRequest({",
          "            url: baseUrl + '/api/auth/login',",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/json' },",
          "            body: { mode: 'raw', raw: JSON.stringify({ account: 'staff', password: '123' }) }",
          "        }, function (err, res) {",
          "            if (!err && res.code === 200) {",
          "                const data = res.json();",
          "                if (data.token) {",
          "                    pm.collectionVariables.set('staff_token', data.token);",
          "                    pm.environment.set('staff_token', data.token);",
          "                    pm.globals.set('staff_token', data.token);",
          "                }",
          "            }",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ],
