    {
      "name": "01. Order Lifecycle Flow (State Machine)",
      "item": [
        {
          "name": "TC_API_ORD_001 - Tạo đơn hàng đặt món mới (Status: PENDING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains order data and PENDING status', function () {",
                  "    var res = pm.response.json();",
                  "    var order = res.data || res.order || res;",
                  "    pm.expect(order).to.have.property('id');",
                  "    pm.expect(order.status).to.eql('PENDING');",
                  "    pm.expect(order.paymentStatus).to.eql('UNPAID');",
                  "    pm.collectionVariables.set('createdOrderId', String(order.id));",
                  "    pm.environment.set('createdOrderId', String(order.id));",
                  "    pm.globals.set('createdOrderId', String(order.id));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"table_id\": 1,\n  \"items\": [\n    {\n      \"product_id\": 1,\n      \"quantity\": 2,\n      \"note\": \"Không cay\"\n    }\n  ],\n  \"note\": \"Đơn hàng bàn 1\",\n  \"used_points\": 0\n}"
