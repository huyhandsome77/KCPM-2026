    {
      "name": "02. Boundary & Security Tests (Kiểm thử Biên & An toàn)",
      "item": [
        {
          "name": "TC_API_STAT_010 - Xử lý khi truyền tham số date sai định dạng không phải ngày ('invalid-date')",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Server handles invalid date safely without crashing (200 OK)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "",
                  "pm.test('Response is valid JSON and contains stats structure', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res).to.be.an('object');",
                  "    pm.expect(res).to.have.property('type');",
                  "    pm.expect(res).to.have.property('totalOrders');",
                  "    pm.expect(res).to.have.property('totalRevenue');",
