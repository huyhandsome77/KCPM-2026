                "type": "text/javascript",
                "exec": [
                  "pm.test('Server safely sanitizes SQL Injection payload and responds with 200 OK without crashing', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "",
                  "pm.test('Database structure is not exposed and response is clean JSON', function () {",
                  "    var responseText = pm.response.text();",
                  "    pm.expect(responseText).to.not.include('syntax error');",
                  "    pm.expect(responseText).to.not.include('SequelizeDatabaseError');",
                  "    pm.expect(responseText).to.not.include('Incorrect DATETIME value');",
                  "    var res = pm.response.json();",
                  "    pm.expect(res).to.be.an('object');",
                  "    pm.expect(res).to.have.property('totalOrders');",
                  "    pm.expect(res).to.have.property('totalRevenue');",
                  "});"
                ]
              }
            }
