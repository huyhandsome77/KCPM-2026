    {
      "name": "01. Statistical Reports (Báo cáo Thống kê Doanh thu)",
      "item": [
        {
          "name": "TC_API_STAT_001 - Lấy báo cáo thống kê doanh thu theo ngày chỉ định thành công với quyền Admin (type=day)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains correct daily statistic structure', function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res).to.be.an('object');",
                  "    pm.expect(res.type).to.eql('day');",
                  "    pm.expect(res).to.have.property('startDate');",
                  "    pm.expect(res).to.have.property('endDate');",
                  "    pm.expect(res).to.have.property('totalOrders');",
                  "    pm.expect(res).to.have.property('totalRevenue');",
                  "    pm.expect(res.totalOrders).to.be.a('number');",
                  "    pm.expect(res.totalRevenue).to.be.a('number');",
                  "    pm.expect(res.totalOrders).to.be.at.least(0);",
                  "    pm.expect(res.totalRevenue).to.be.at.least(0);",
                  "});",
                  "",
                  "pm.test('Response time is acceptable (< 500ms)', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stats?type=day&date=2026-09-04",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stats"
