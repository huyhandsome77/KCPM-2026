    "description": "SCRUM-25 - JWT Testcase. Đã bổ sung/cập nhật Assertions cho toàn bộ 11 testcase. JWT-TOKEN-06 kỳ vọng 'No token'; JWT-TOKEN-07 kỳ vọng 'Invalid token'."
  },
  "item": [
    {
      "name": "JWT-AUTH-01 - Login thành công",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"account\": \"admin\",\r\n  \"password\": \"123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test(\"Có JWT token\", function () {",
              "    pm.expect(json).to.have.property(\"token\");",
              "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "pm.test(\"Có thông tin user\", function () {",
              "    pm.expect(json).to.have.property(\"user\");",
              "});",
              "",
              "// Lưu JWT mới để các testcase JWT phía sau sử dụng.",
              "pm.collectionVariables.set(\"jwt_token\", json.token);"
            ]
          }
        }
      ]
    },
