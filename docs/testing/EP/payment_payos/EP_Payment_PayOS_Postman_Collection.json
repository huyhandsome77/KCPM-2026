{
  "info": {
    "_postman_id": "ep-payment-payos-full-suite-2026",
    "name": "FutureSushi - Payment & PayOS Gateway EP Test Suite (SCRUM-67)",
    "description": "Bộ kiểm thử tự động Phân hoạch tương đương (Equivalence Partitioning - EP) toàn diện bao phủ 11/11 lớp tương đương cho Module Payment & PayOS Gateway Webhook (SCRUM-67) theo đặc tả SRS Mục 2.6.1.7.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "order_unready_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "payos_order_code",
      "value": "12345678",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Setup & Authentication Tokens",
      "item": [
        {
          "name": "0.1 Setup - Admin Login (Get Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Admin Login successful\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.collectionVariables.set(\"admin_token\", jsonData.token);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"account\": \"admin\", \"password\": \"123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "0.2 Setup - Tạo đơn hàng mẫu phục vụ Test Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Setup Order created\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.collectionVariables.set(\"order_id\", String(jsonData.data.id));",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"table_id\": 1, \"items\": [{\"product_id\": 1, \"quantity\": 1}], \"note\": \"Setup for Payment EP\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Equivalence Partitioning (EP) - Payment & PayOS Gateway (9 Test Cases - 11 EP Classes)",
      "item": [
        {
          "name": "[TC_EP_PAY_01] Valid EP (EQ_MTH1, EQ_OST1, EQ_PST1): Thanh toán đơn bằng CASH thành công khi đơn READY",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set order to READY before paying",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/api/orders/' + pm.variables.get('order_id') + '/status',",
                  "    method: 'PUT',",
                  "    header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.variables.get('admin_token') },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ status: 'READY' }) }",
                  "}, function (err, res) {});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[TC_EP_PAY_01] Status 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"[TC_EP_PAY_01] Xác nhận thanh toán thành công\", function () {",
                  "    pm.expect(jsonData.message).to.include('Thanh toán thành công');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"paymentMethod\": \"CASH\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{order_id}}/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{order_id}}",
                "pay"
              ]
            }
          }
        },
        {
          "name": "[TC_EP_PAY_02] Valid EP (EQ_AMT1): Tạo link thanh toán PayOS thành công cho đơn hàng hợp lệ",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[TC_EP_PAY_02] Status 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"[TC_EP_PAY_02] Trả về link checkoutUrl hoặc qrCode\", function () {",
                  "    pm.expect(jsonData).to.have.property('checkoutUrl');",
                  "});",
                  "if (jsonData.data && jsonData.data.orderCode) {",
                  "    pm.collectionVariables.set(\"payos_order_code\", String(jsonData.data.orderCode));",
                  "} else if (jsonData.orderCode) {",
                  "    pm.collectionVariables.set(\"payos_order_code\", String(jsonData.orderCode));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"orderId\": {{order_id}}}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payos/create-payment-link",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payos",
                "create-payment-link"
              ]
            }
          }
        },
        {
          "name": "[TC_EP_PAY_03] Valid EP (EQ_WB1): Xử lý Webhook PayOS thành công (code = '00'), kiểm tra đơn chuyển PAID và COMPLETED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[TC_EP_PAY_03] Status 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"[TC_EP_PAY_03] Webhook phản hồi Success\", function () {",
                  "    pm.expect(jsonData.message).to.eql('Success');",
                  "});",
                  "// Kiểm tra trạng thái thực tế của đơn hàng và bàn trong DB sau khi Webhook xử lý",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/api/orders/' + pm.variables.get('order_id'),",
                  "    method: 'GET',",
                  "    header: { 'Authorization': 'Bearer ' + pm.variables.get('admin_token') }",
                  "}, function (err, res) {",
                  "    pm.test(\"[TC_EP_PAY_03] Kiểm tra đơn hàng chuyển PAID/COMPLETED và bàn AVAILABLE\", function () {",
                  "        var orderData = res.json();",
                  "        pm.expect(orderData.paymentStatus).to.eql('PAID');",
                  "        pm.expect(orderData.status).to.eql('COMPLETED');",
                  "        if (orderData.RestaurantTable) {",
                  "            pm.expect(orderData.RestaurantTable.status).to.eql('AVAILABLE');",
                  "        }",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"code\": \"00\", \"desc\": \"success\", \"data\": {\"orderCode\": {{payos_order_code}}, \"amount\": 150000, \"description\": \"THANHTOAN DH\", \"transactionDateTime\": \"2026-09-12 10:00:00\"}}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payos/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payos",
                "webhook"
              ]
            }
          }
        },
        {
          "name": "[TC_EP_PAY_04] Invalid EP (EQ_OST2): Từ chối thanh toán khi đơn hàng chưa hoàn thành (status = PREPARING)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Create a fresh unready order for this test",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/api/orders',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.variables.get('admin_token') },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ table_id: 1, items: [{ product_id: 1, quantity: 1 }], note: 'Unready test' }) }",
                  "}, function (err, res) {",
                  "    if (res && res.json && res.json().data) {",
                  "        var unreadyId = String(res.json().data.id);",
                  "        pm.collectionVariables.set('order_unready_id', unreadyId);",
                  "        pm.sendRequest({",
                  "            url: pm.variables.get('baseUrl') + '/api/orders/' + unreadyId + '/status',",
                  "            method: 'PUT',",
                  "            header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.variables.get('admin_token') },",
                  "            body: { mode: 'raw', raw: JSON.stringify({ status: 'PREPARING' }) }",
                  "        }, function () {});",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[TC_EP_PAY_04] Status 400 Bad Request\", function () {",
                  "    pm.expect(pm.response.code).to.eql(400);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"[TC_EP_PAY_04] Báo lỗi trạng thái đơn không hợp lệ\", function () {",
                  "    pm.expect(jsonData.message).to.include('phải ở trạng thái');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"paymentMethod\": \"CASH\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{order_unready_id}}/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{order_unready_id}}",
                "pay"
              ]
            }
          }
        },
        {
          "name": "[TC_EP_PAY_05] Invalid EP (EQ_PST2): Từ chối thanh toán lại cho đơn hàng đã PAID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Ensure {{order_id}} is already PAID before attempting to pay again",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/api/orders/' + pm.variables.get('order_id') + '/status',",
                  "    method: 'PUT',",
                  "    header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.variables.get('admin_token') },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ status: 'READY' }) }",
                  "}, function () {",
                  "    pm.sendRequest({",
                  "        url: pm.variables.get('baseUrl') + '/api/orders/' + pm.variables.get('order_id') + '/pay',",
                  "        method: 'PUT',",
                  "        header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.variables.get('admin_token') },",
                  "        body: { mode: 'raw', raw: JSON.stringify({ paymentMethod: 'CASH' }) }",
                  "    }, function () {});",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[TC_EP_PAY_05] Status 400 Bad Request\", function () {",
                  "    pm.expect(pm.response.code).to.eql(400);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"[TC_EP_PAY_05] Báo lỗi đơn đã thanh toán\", function () {",
                  "    pm.expect(jsonData.message).to.include('đã được thanh toán');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"paymentMethod\": \"CASH\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{order_id}}/pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{order_id}}",
                "pay"
              ]
            }
          }
        },
        {
          "name": "[TC_EP_PAY_06] Invalid EP (EQ_WB2): Xử lý Webhook PayOS khi giao dịch bị hủy (code = '01'), kiểm tra đơn giữ UNPAID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[TC_EP_PAY_06] Status 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"[TC_EP_PAY_06] Webhook phản hồi Success\", function () {",
                  "    pm.expect(jsonData.message).to.eql('Success');",
                  "});",
                  "// Kiểm tra đơn hàng vẫn ở trạng thái UNPAID",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/api/orders/' + pm.variables.get('order_unready_id'),",
                  "    method: 'GET',",
                  "    header: { 'Authorization': 'Bearer ' + pm.variables.get('admin_token') }",
                  "}, function (err, res) {",
                  "    pm.test(\"[TC_EP_PAY_06] Xác nhận đơn hàng không bị chuyển sang PAID (vẫn UNPAID)\", function () {",
                  "        var orderData = res.json();",
                  "        pm.expect(orderData.paymentStatus).to.eql('UNPAID');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"code\": \"01\", \"desc\": \"User Cancelled\", \"data\": {\"orderCode\": 999999}}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payos/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payos",
                "webhook"
              ]
            }
          }
        },
        {
          "name": "[TC_EP_PAY_07] Invalid EP (EQ_AMT2): Từ chối tạo link thanh toán khi số tiền dưới mức tối thiểu (amount < 1.000 VNĐ)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[TC_EP_PAY_07] Status 400 Bad Request\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 404]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"[TC_EP_PAY_07] Báo lỗi số tiền thanh toán dưới mức tối thiểu\", function () {",
                  "    pm.expect(jsonData.message).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
