    {
      "name": "0. Setup & Authentication Tokens",
      "item": [
        {
          "name": "0.1 Setup - Admin Login (Get Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"account\":\"admin\",\"password\":\"123\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"0.1 Admin login thành công - HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.token).to.be.a(\"string\");",
                  "  pm.collectionVariables.set(\"admin_token\", res.token);",
                  "  pm.collectionVariables.set(\"staff_token\", res.token);",
                  "  pm.environment && pm.environment.set(\"admin_token\", res.token);",
                  "  pm.environment && pm.environment.set(\"staff_token\", res.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 Setup - Customer Login (Get Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"account\":\"customer\",\"password\":\"123\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"0.2 Customer login thành công - HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.token).to.be.a(\"string\");",
                  "  pm.collectionVariables.set(\"customer_token\", res.token);",
                  "  pm.environment && pm.environment.set(\"customer_token\", res.token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
