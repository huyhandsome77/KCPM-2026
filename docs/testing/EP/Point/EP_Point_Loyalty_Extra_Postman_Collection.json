{
  "info": {
    "_postman_id": "ep-point-loyalty-extra-2026",
    "name": "EP - Point & Loyalty - Extra Equivalence Classes",
    "description": "EP execution for input classes not directly covered by the existing Point API suite: invalid phone format and non-integer orderId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "staff_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00. Auth Setup",
      "item": [
        {
          "name": "Login as Staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"account\":\"staff\",\"password\":\"123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Staff login success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.token).to.be.a('string');",
                  "  pm.collectionVariables.set('staff_token', res.token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01. EP Extra Input Classes",
      "item": [
        {
          "name": "EP-POINT-007 - Phone sai định dạng (chứa chữ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"09012abcde\",\n  \"orderId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/points/add-points",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "points",
                "add-points"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid phone format should be rejected with 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "EP-POINT-009 - orderId là số thập phân",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phoneForOrderIdTest}}\",\n  \"orderId\": 1.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/points/add-points",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "points",
                "add-points"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Use a real customer phone from your test data if the default is not present.",
                  "pm.variables.set('phoneForOrderIdTest', pm.collectionVariables.get('phoneForOrderIdTest') || '0123456789');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Non-integer orderId should be rejected with 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}