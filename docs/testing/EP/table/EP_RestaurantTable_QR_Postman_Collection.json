{
  "info": {
    "_postman_id": "futuresushi-ep-table-srs-aligned-2026",
    "name": "FutureSuShi - EP Restaurant Table & QR - SRS Aligned",
    "description": "15 representative Equivalence Partitioning test cases aligned to the supplied SRS. Built-in fixture setup ensures standalone, reproducible execution across environments without pre-existing data requirements.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "existingTableId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "existingQrCode",
      "value": "QR-EP-0001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00. Setup Fixtures",
      "item": [
        {
          "name": "0.1 Setup - Fetch & Clean Test Tables Fixture",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tables",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tables"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function() {",
                  "    pm.test('0.1 Get all tables status is 200', () => pm.response.to.have.status(200));",
                  "    const data = pm.response.json();",
                  "    const tables = Array.isArray(data) ? data : (data.tables || data.data || []);",
                  "    const baseUrl = pm.collectionVariables.get('baseUrl') || pm.environment.get('baseUrl') || 'http://localhost:3000';",
                  "    ",
                  "    // Clean up any leftover EP test table numbers [250..257]",
                  "    const testNumbers = [250, 251, 252, 253, 254, 255, 256, 257];",
                  "    tables.forEach(t => {",
                  "        if (t && t.id && testNumbers.includes(Number(t.tableNumber))) {",
                  "            pm.sendRequest({ url: baseUrl + '/api/tables/' + t.id, method: 'DELETE' }, () => {});",
                  "        }",
                  "    });",
                  "    ",
                  "    // Find an existing base table or use the first available table",
                  "    const baseTable = tables.find(t => t && t.id && Number(t.tableNumber) === 1) || tables.find(t => t && t.id);",
                  "    if (baseTable) {",
                  "        pm.collectionVariables.set('existingTableId', String(baseTable.id));",
                  "        pm.collectionVariables.set('existingQrCode', String(baseTable.qrCode || 'QR-EP-0001'));",
                  "        if (pm.environment) {",
                  "            pm.environment.set('existingTableId', String(baseTable.id));",
                  "            pm.environment.set('existingQrCode', String(baseTable.qrCode || 'QR-EP-0001'));",
                  "        }",
                  "    }",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 Setup - Ensure Base Fixture Table Exists",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": 1,\n  \"capacity\": 4,\n  \"qrCode\": \"QR-EP-0001\",\n  \"status\": \"AVAILABLE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tables",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tables"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function() {",
                  "    pm.test('0.2 Fixture table check (201 Created or 400 Already Exists)', () => {",
                  "        pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]);",
                  "    });",
                  "    if (pm.response.code === 201) {",
                  "        const d = pm.response.json();",
                  "        if (d.table && d.table.id) {",
                  "            pm.collectionVariables.set('existingTableId', String(d.table.id));",
                  "            pm.collectionVariables.set('existingQrCode', String(d.table.qrCode || 'QR-EP-0001'));",
                  "            if (pm.environment) {",
                  "                pm.environment.set('existingTableId', String(d.table.id));",
                  "                pm.environment.set('existingQrCode', String(d.table.qrCode || 'QR-EP-0001'));",
                  "            }",
                  "        }",
                  "    }",
                  "})();"
                ]
              }
            }
          ]
        }
      ]
    },
