{
  "info": {
    "_postman_id": "futuresushi-ep-table-srs-aligned-2026",
    "name": "FutureSuShi - EP Restaurant Table & QR - SRS Aligned",
    "description": "15 representative Equivalence Partitioning test cases aligned to the supplied SRS. No execution result is embedded. SRS names qr_token; current implementation uses qrCode, so the collection explicitly tests the mapping and the SRS-vs-implementation mismatch for status values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "existingTableId",
      "value": "1"
    },
    {
      "key": "existingQrCode",
      "value": "QR-EP-0001"
    }
  ],
  "item": [
    {
      "name": "EP - Restaurant Table & QR (15 SRS-Aligned Cases)",
      "item": [
        {
          "name": "EP-SRS-TB-001 - tableNumber valid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": 250,\n  \"capacity\": 4,\n  \"qrCode\": \"QR-EP-2500\",\n  \"status\": \"AVAILABLE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tables"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201',()=>pm.response.to.have.status(201));",
                  "pm.test('Response is JSON',()=>pm.response.to.be.json);",
                  "const d=pm.response.json();",
                  "pm.test('Payload has table',()=>pm.expect(d.table).to.be.an('object'));",
                  "pm.test('tableNumber=250',()=>pm.expect(Number(d.table.tableNumber)).to.eql(250));",
                  "pm.test('capacity=4',()=>pm.expect(Number(d.table.capacity)).to.eql(4));",
                  "pm.test('qrCode matches',()=>pm.expect(String(d.table.qrCode)).to.eql('QR-EP-2500'));",
                  "pm.test('status=AVAILABLE',()=>pm.expect(String(d.table.status)).to.eql('AVAILABLE'));",
                  "if(d.table&&d.table.id)pm.sendRequest({url:pm.environment.get('baseUrl')+'/api/tables/'+d.table.id,method:'DELETE'},()=>{});"
                ]
              }
            }
          ]
        },
