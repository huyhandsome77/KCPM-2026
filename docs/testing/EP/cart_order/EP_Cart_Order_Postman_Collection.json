{
  "info": {
    "_postman_id": "ep-cart-order-full-suite-2026",
    "name": "FutureSushi - Cart & Order EP Test Suite (SCRUM-66)",
    "description": "Bộ kiểm thử tự động Phân hoạch tương đương (Equivalence Partitioning - EP) cho Module Cart & Order Management (SCRUM-66) theo đặc tả SRS Mục 2.6.1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Setup & Authentication Tokens",
      "item": [
        {
          "name": "0.1 Setup - Admin Login (Get Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Admin Login successful\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.collectionVariables.set(\"admin_token\", jsonData.token);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"account\": \"admin\", \"password\": \"123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Equivalence Partitioning (EP) - Cart & Order (10 Test Cases)",
      "item": [
        {
          "name": "[TC_EP_01] Valid EP (EQ_CRT1, EQ_Q1, EQ_P1, EQ_NOT1, EQ_S1): Tạo đơn hàng thành công với giỏ hàng hợp lệ đầy đủ tham số",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/api/users/1',",
                  "    method: 'PUT',",
                  "    header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.variables.get('admin_token') },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ points: 1000 }) }",
                  "}, function (err, res) {});",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/api/products/1',",
                  "    method: 'PUT',",
                  "    header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.variables.get('admin_token') },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ stock: 100, isAvailable: true }) }",
                  "}, function (err, res) {});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"[TC_EP_01] Status 201 Created\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"[TC_EP_01] Tính đúng totalPrice và finalPrice\", function () {",
                  "    if (jsonData.data) {",
                  "        pm.expect(Number(jsonData.data.totalPrice)).to.be.above(0);",
                  "        pm.expect(Number(jsonData.data.discountAmount)).to.eql(500);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"table_id\": 1, \"used_points\": 500, \"note\": \"\\u00edt cay\", \"items\": [{\"product_id\": 1, \"quantity\": 5, \"note\": \"\\u00edt cay\"}]}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        },
