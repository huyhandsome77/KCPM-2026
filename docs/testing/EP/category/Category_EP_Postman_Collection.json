                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 201 Created', function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "const json = pm.response.json();",
                                    "pm.test('Tạo danh mục thành công với đầy đủ thông tin', function () {",
                                    "    pm.expect(json.name).to.eql('Nigiri Sushi');",
                                    "    pm.expect(json.description).to.eql('Sushi nắm truyền thống');",
                                    "    pm.expect(json.image).to.eql('nigiri.jpg');",
                                    "    pm.expect(json.id).to.exist;",
                                    "    pm.expect(Number(json.id)).to.be.above(0);",
                                    "});",
                                    "if (json.id) { pm.collectionVariables.set('created_cat_id', String(json.id)); }"
