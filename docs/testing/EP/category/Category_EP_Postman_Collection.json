        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "pm.test('[Non-Functional] Response time is acceptable', function () {",
                    "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                    "});"
                ]
            }
        }
    ],
