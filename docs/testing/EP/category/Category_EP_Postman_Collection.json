    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "pm.collectionVariables.set('cat_name_130', 'A'.repeat(130));",
                    "pm.collectionVariables.set('cat_desc_501', 'D'.repeat(501));",
                    "pm.collectionVariables.set('cat_image_260', 'https://example.com/' + 'i'.repeat(240));",
                    "pm.collectionVariables.set('cat_search_101', 'S'.repeat(101));",
                    "if (!pm.collectionVariables.get('created_empty_cat_id')) {",
                    "    pm.collectionVariables.set('created_empty_cat_id', '2');",
                    "}"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "pm.test('[Non-Functional] Response time is acceptable (< 1500ms)', function () {",
                    "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                    "});"
                ]
            }
        }
